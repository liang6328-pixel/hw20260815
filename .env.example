# Mock Test Generator - Environment Configuration

# OCR Service
# VITE_OCR_SERVICE=tesseract  # or 'google-vision', 'aws-textract'
# VITE_OCR_API_KEY=your_api_key_here

# AI Service for Question Generation
# VITE_AI_SERVICE=openai     # or 'claude', 'google-palm'
# VITE_AI_API_KEY=your_api_key_here
# VITE_AI_MODEL=gpt-4        # Model to use for generation

# Backend API
# VITE_API_URL=http://localhost:3000/api

# Feature Flags
VITE_DEMO_MODE=true           # Enable demo mode by default
VITE_ENABLE_CAMERA=true       # Enable camera capture
VITE_ENABLE_FILE_IMPORT=true  # Enable file import
VITE_ENABLE_PDF_IMPORT=false  # PDF support (experimental)
